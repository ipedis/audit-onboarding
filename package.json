{
  "name": "audit-onboarding",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-static.mjs --dist",
    "preview": "vite preview",
    "lint": "eslint vite.config.js eslint.config.js src/js scripts && stylelint \"src/scss/**/*.scss\" && node scripts/check-static.mjs",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.{html,js,scss}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{js,json,md}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{html,js,scss}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.{js,json,md}\"",
    "check": "npm run format:check && npm run lint && npm run build"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "stylelint": "17.14.1",
    "vite": "8.2.2"
  }
}
